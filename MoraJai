pygame.init()

board = [['WHITE' for _ in range(3)] for _ in range (3)]
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
color_dict = {'WHITE': (255, 255, 255), 'BLACK': (0, 0, 0), 'RED': (255, 0, 0), 'BLUE': (0, 0, 255), 'GREEN' : (0, 255, 0)}
MIDDLE_POS = (1,1)

class Button:
    def __init__(self, rect, color, position):
        self.rect = rect
        self.color = color
        self.position = position

def init_board():
    button_x = WIDTH/3
    button_y = HEIGHT/3
    button_width = 100
    button_height = 100
    for row in range(len(board)):
        for col in range(len(board[row])):
            # for the testing of the green function
            board[col][row] = Button(pygame.Rect(button_x, button_y, 100, 100), color_dict['BLUE'], (col, row))
            button_x += button_width + 10
        button_x -= (button_width + 10) * len(board[row])
        button_y += button_height + 10
    # for the testing the color functions
    board[1][2].color = color_dict['BLACK']
    board[0][2].color = color_dict['BLACK']
    board[0][0].color = color_dict['GREEN']

def print_board():
    screen.fill(color_dict['WHITE'])
    for row in range(len(board)):
        for col in range(len(board[row])):
            pygame.draw.rect(screen, board[col][row].color, board[col][row].rect)
    pygame.display.flip()

def morajai(cur_board, cur_button):
    # swaps position with the tile across the center
    if cur_button.color == color_dict['GREEN']:
        # the number 2 here is used because that's the maximum index of a 3x3 grid, 0,1,2
        ref_position = (abs(cur_button.position[0] - 2 ), abs(cur_button.position[1] - 2))
        temp_color = board[ref_position[0]][ref_position[1]].color
        cur_button.color = temp_color
        board[ref_position[0]][ref_position[1]].color = color_dict['GREEN']

    #shifts it's row to the right
    elif cur_button.color == color_dict['BLACK']:
        cur_row_val = cur_button.position[1]
        temp_row = [Button(pygame.Rect(100, 100, 100, 100), color_dict['RED'], (0, 0)), Button(pygame.Rect(100, 100, 100, 100), color_dict['RED'], (0, 0)), Button(pygame.Rect(100, 100, 100, 100), color_dict['RED'], (0, 0))]
        for i in range(len(board)):
            temp_row[(i + 1)%3].color = board[i][cur_row_val].color
        for i in range(len(board)):
            board[i][cur_row_val].color = temp_row[i].color

    elif cur_button.color == color_dict['YELLOW']:

    else:
        cur_button.color = color_dict['RED']


def main():
    init_board()
    while True:
        print_board()
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
            if event.type == pygame.MOUSEBUTTONDOWN:
                mouse_pos = event.pos
                for row in range(len(board)):
                    for col in range(len(board[row])):
                        if board[col][row].rect.collidepoint(mouse_pos):
                            morajai(board, board[col][row])
                            print_board()


# Press the green button in the gutter to run the script.
if __name__ == '__main__':
    main()

